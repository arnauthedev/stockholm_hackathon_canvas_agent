# Required
OPENAI_API_KEY=
# Gemini Live is the default realtime voice (GOOGLE_API_KEY works too). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generated by scripts/bootstrap.sh
RUNNER_TOKEN=

# Location-dependent (defaults shown)
AGENT_HOME=./agent-home
PORT=18787
APP_PORT=15180
# Leave empty to use the quick tunnel URL detected by scripts/dev.sh
PUBLIC_URL=

# The user's IANA timezone and locale: "local time" (reminders, cron, Python) and date labels use these.
# Defaults: the machine's timezone and en-GB.
TIMEZONE=Europe/Stockholm
LOCALE=en-GB

# Route overrides: ROUTE_<job>=provider/model[@effort]  (e.g. ROUTE_brain=openai/gpt-6-luna@minimal)
# ROUTE_brain=
# ROUTE_subagent=
# Realtime conversation provider (see config/routes.ts): google/gemini-3.8-live (default, lowest delay),
# google/gemini-3.8-live-extended-thinking@low or openai/gpt-live-1
# ROUTE_voice=openai/gpt-live-1
# Live vision (the video-camera button: talk while the camera streams) always needs a provider that takes video:
# ROUTE_liveVision=google/gemini-3.8-live (default) or google/gemini-3.8-live-extended-thinking@low
# VOICE_DEBUG=1 logs every Gemini Live server message (timing, transcripts, tool calls)
# VOICE_NO_BARGE_IN=1: Gemini ignores speech while the agent talks (immune to echo, but you cannot talk over it)

# Side effects (sending email, calling) stay stubbed unless true
ENABLE_SIDE_EFFECTS=false

# Web Push: the runner generates the key pair on first use and appends it to .env — leave these commented.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional, disabled routes
# AI_GATEWAY_API_KEY=
# AGENTMAIL_API_KEY=

# Email (free): Gmail with an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Sending also needs ENABLE_SIDE_EFFECTS=true; otherwise approved emails are saved to agent-home/outbox/.
# EMAIL_USER=you@gmail.com
# EMAIL_PASSWORD=abcdabcdabcdabcd
# EMAIL_FROM_NAME=Your Name
# Other providers: EMAIL_SMTP_HOST / EMAIL_SMTP_PORT / EMAIL_IMAP_HOST / EMAIL_IMAP_PORT
